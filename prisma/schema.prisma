datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  login     String
  password  String
  version   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model Artist {
  id       String  @id @default(uuid())
  name     String
  grammy   Boolean
  favorite Boolean
}

model Album {
  id       String  @id @default(uuid())
  name     String
  year     Int
  artistId String?
  favorite Boolean
}

model Track {
  id       String  @id @default(uuid())
  name     String
  artistId String?
  albumId  String?
  duration Int
  favorite Boolean
}
